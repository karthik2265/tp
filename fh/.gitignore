# ==========================================
# Environment & secrets
# ==========================================
.env
.env.*
!.env.example

# ==========================================
# Go build output
# ==========================================
# Binaries from `go build -o bin/...`
bin/
/replay
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binaries and coverage
*.test
*.out
coverage.*
*.coverprofile
profile.cov

# Workspace file (local multi-module setups)
go.work
go.work.sum

# Dependency directory (only if you ever run `go mod vendor`)
vendor/

# ==========================================
# Data
# ==========================================
# macOS Archive Utility leftovers from double-clicking a .zst
*.cpgz

# ==========================================
# Editors & OS
# ==========================================
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
